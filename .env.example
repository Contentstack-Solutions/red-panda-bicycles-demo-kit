# Copy to .env.local and fill in. Run `npm run kit:doctor` to check everything.
# Never commit .env.local.

# ---- Contentstack ----
# Stack API key: Contentstack -> your stack -> Settings -> Stack -> API Key.
CONTENTSTACK_API_KEY=
# Management token WITH WRITE ACCESS: Settings -> Tokens -> Management Tokens. Used by the setup scripts only.
CONTENTSTACK_MANAGEMENT_TOKEN=
# Delivery token: Settings -> Tokens -> Delivery Tokens. Scope it to the environment below.
CONTENTSTACK_DELIVERY_TOKEN=
# Preview token (Live Preview): Settings -> Tokens -> Delivery Tokens -> create a preview token.
CONTENTSTACK_PREVIEW_TOKEN=
# Environment the site reads (e.g. launch). Settings -> Environments. Publish to this one, not only "preview".
CONTENTSTACK_ENVIRONMENT=
# Comma-separated environment names the setup publishes to. Defaults to CONTENTSTACK_ENVIRONMENT, else preview.
CONTENTSTACK_PUBLISH_ENVIRONMENTS=
# Region: us, eu, au, azure-na, azure-eu, gcp-na or gcp-eu. Matches the URL you sign in at.
CONTENTSTACK_REGION=us
# Hosts for your region (defaults are for US). See Contentstack docs: "API endpoints".
CONTENTSTACK_HOST=cdn.contentstack.io
# Management API host used by the setup scripts (not the CDN host above). EU: eu-api.contentstack.com, Azure NA: azure-na-api.contentstack.com, Azure EU: azure-eu-api.contentstack.com.
CONTENTSTACK_MANAGEMENT_HOST=api.contentstack.io
CONTENTSTACK_PREVIEW_HOST=rest-preview.contentstack.com
CONTENTSTACK_APP_HOST=app.contentstack.com
# Stack branch to read and write.
CONTENTSTACK_BRANCH=main
# Live Preview on/off (true or false).
LIVE_PREVIEW_ENABLED=true
# Organization UID: Contentstack -> Organization -> Settings (also in the URL of org pages).
CONTENTSTACK_ORGANIZATION_UID=

# ---- Commerce (RP Commerce app) ----
# Install "RP Commerce" in your stack first: Contentstack -> Marketplace -> Apps (ask the app owner for access).
# OPTIONAL: the live store. Set all three or leave all blank. Blank: product and category pages show the products
# saved in the CMS, and the cart stays empty. Values come from the app owner / the app's configuration screen.
RED_PANDA_COMMERCE_API_URL=
RED_PANDA_COMMERCE_STPRE_ID=
RED_PANDA_COMMERCE_STPRE_TOKEN=

# ---- Lytics ----
# Admin access token: Lytics -> Account -> Access Tokens (used by the setup scripts).
LYTICS_ACCESS_TOKEN=
# Lytics tag / account ID (NOT the access token): Lytics -> Account -> Account Settings -> Account ID / JS tag.
LYTICS_TAG=

# ---- Personalize ----
# Project UID: Contentstack -> Personalize -> your project -> Settings (also in the project URL).
CONTENTSTACK_PERSONALIZE_PROJECT_UID=
# Personalize project UID (the site reads it under this name; same value as CONTENTSTACK_PERSONALIZE_PROJECT_UID).
CONTENTSTACK_PERSONALIZATION=
# Personalize Edge API URL for your region, e.g. https://personalize-edge.contentstack.com
CONTENTSTACK_PERSONALIZE_EDGE_API_URL=
# Personalize and Brand Kit API hosts. Leave blank for the US region (personalize-api.contentstack.com,
# brand-kits-api.contentstack.com, ai.contentstack.com). Other regions: set your region's hosts here
# (untested outside the US; npm run kit:doctor warns when CONTENTSTACK_REGION isn't us and these are blank).
CONTENTSTACK_PERSONALIZE_API_HOST=
CONTENTSTACK_BRANDKIT_API_HOST=
CONTENTSTACK_AI_HOST=
# Contentstack session authtoken: not set here. Run `node .claude/skills/red-panda-customer-insights/scripts/rp.mjs login`
# in Terminal; it stores the token in the macOS keychain (or ~/.red-panda/credentials.env), where the setup
# scripts and the helper read it. It expires after a few hours; log in again when doctor reports a 401.

# ---- Brand Kit ----
# Brand Kit UID: Contentstack -> Brand Kit -> your kit (in the URL). Create the kit in the same organization.
BRAND_KIT_UID=

# ---- Site ----
# Your Launch site URL, e.g. https://my-red-panda.contentstackapps.com (not localhost: the Lytics seeder uses its domain).
# To check a local dev server, pass --site http://localhost:3000 to npm run kit:verify instead.
SITE_URL=
# Set to "launch" only when deploying on Contentstack Launch.
HOSTING=
# CARTO basemaps key for the map (starts with cb1_; an eyJ... JWT is the wrong kind): carto.com -> API access keys.
# Allow localhost and your Launch domain on the key. Leave blank to skip the map.
NEXT_PUBLIC_CARTO_API_KEY=

# ---- Persona ----
# Email of the demo persona. Lowercase, no "+" (Lytics search breaks on it). Used by the site and the Lytics seeder.
DEMO_PERSONA_EMAIL=
